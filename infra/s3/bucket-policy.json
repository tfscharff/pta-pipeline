{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDeletingArchiveContent",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion", "s3:DeleteBucket"],
      "Resource": ["arn:aws:s3:::project.muse", "arn:aws:s3:::project.muse/*"]
    },
    {
      "Sid": "DenyIndirectDeletion",
      "Effect": "Deny",
      "Principal": "*",
      "Action": ["s3:PutLifecycleConfiguration", "s3:PutBucketVersioning"],
      "Resource": "arn:aws:s3:::project.muse"
    },
    {
      "Sid": "AllowCloudFrontReadOnly",
      "Effect": "Allow",
      "Principal": { "Service": "cloudfront.amazonaws.com" },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::project.muse/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::ACCOUNT_ID:distribution/EWK48TT92QAN"
        }
      }
    }
  ]
}
