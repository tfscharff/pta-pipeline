{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ContentObjects",
      "Effect": "Allow",
      "Action": [
        "s3:RestoreObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetObjectTagging",
        "s3:GetObjectVersionTagging",
        "s3:PutObject",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::BUCKET/*"
    },
    {
      "Sid": "ContentBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::BUCKET"
    },
    {
      "Sid": "OpsBucketRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::OPS_BUCKET", "arn:aws:s3:::OPS_BUCKET/*"]
    },
    {
      "Sid": "OpsBucketReports",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::OPS_BUCKET/reports/*"
    }
  ]
}
